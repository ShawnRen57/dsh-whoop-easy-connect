{
  "name": "dsh-whoop-easy-connect",
  "version": "1.0.0",
  "type": "module",
  "description": "Easy WHOOP connection with automatic data sync and a dedicated health dashboard for DeepSeek Harness.",
  "license": "MIT",
  "author": "ShawnRen57",
  "homepage": "https://github.com/ShawnRen57/dsh-whoop-easy-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnRen57/dsh-whoop-easy-connect.git"
  },
  "bugs": {
    "url": "https://github.com/ShawnRen57/dsh-whoop-easy-connect/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "whoop",
    "health",
    "dashboard",
    "recovery",
    "strain",
    "sleep"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/whoop-api.js",
    "lib/demo-data.js",
    "lib/oauth-page.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "*"
  }
}
